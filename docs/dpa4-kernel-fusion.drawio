<mxfile host="app.diagrams.net" modified="2026-11-24T00:00:00.000Z" agent="Claude Code" version="25.0.3" type="device">
  <diagram id="fusion-grid-pair" name="1 · SO(3) grid pair">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="g-title" value="&lt;b&gt;融合 1 / SO(3) grid pair 乘积&lt;/b&gt;&amp;nbsp;&amp;nbsp;deepmd::dpa4_grid_pair&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;DP_CUDA_INFER &amp;gt;= 1&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;融合动因：中间张量比它的输入大一个量级" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#203B43;strokeColor=#203B43;fontColor=#FFFFFF;fontSize=16;align=left;spacingLeft=16;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1600" height="50" as="geometry"/></mxCell>
        <mxCell id="g-lh" value="&lt;b&gt;未融合：参考组合路径（三次张量缩并）&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F9E5E1;strokeColor=#C96A5A;fontColor=#7A3326;fontSize=14;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="690" height="36" as="geometry"/></mxCell>
        <mxCell id="g-rh" value="&lt;b&gt;融合后：一个核，grid 场不出寄存器&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D9F1EC;strokeColor=#3E8E7E;fontColor=#1F5C50;fontSize=14;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="790" y="90" width="850" height="36" as="geometry"/></mxCell>
        <mxCell id="g-div" style="endArrow=none;html=1;strokeColor=#B9C6C9;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="90" as="sourcePoint"/><mxPoint x="760" y="1010" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="g-l1" value="输入系数算子&lt;br&gt;left (N, P, C)&amp;nbsp;&amp;nbsp;/&amp;nbsp;&amp;nbsp;right (N, P, C)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1EDFA;strokeColor=#5B8DB8;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="690" height="50" as="geometry"/></mxCell>
        <mxCell id="g-l2" value="to_grid ×2（两次投影缩并）&lt;br&gt;lg[n,g,c] = Σ_p T[g,p] · left[n,p,c]&lt;br&gt;rg[n,g,c] = Σ_p T[g,p] · right[n,p,c]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B9C6C9;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="214" width="690" height="68" as="geometry"/></mxCell>
        <mxCell id="g-l3" value="&lt;b&gt;grid 场 lg / rg (N, G, C) 写进 HBM&lt;/b&gt;&lt;br&gt;比产生它的系数算子大 6–10 倍&lt;br&gt;8000 个节点、最宽形状：2.1 GB / 次调用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9E5E1;strokeColor=#C96A5A;fontColor=#7A3326;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="306" width="690" height="70" as="geometry"/></mxCell>
        <mxCell id="g-l4" value="缩并写成跨非相邻轴的 einsum，&lt;b&gt;编译器还会在每次乘法两侧插入全尺寸 layout copy&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9E5E1;strokeColor=#C96A5A;fontColor=#7A3326;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="690" height="52" as="geometry"/></mxCell>
        <mxCell id="g-l5" value="逐点乘 lg · rg&amp;nbsp;&amp;nbsp;→&amp;nbsp;&amp;nbsp;乘积 (N, G, C) 再写一遍、再读一遍" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B9C6C9;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="476" width="690" height="50" as="geometry"/></mxCell>
        <mxCell id="g-l6" value="from_grid（回投缩并）&lt;br&gt;out[n,p,c] = Σ_g F[g,p] · lg[n,g,c] · rg[n,g,c]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B9C6C9;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="690" height="56" as="geometry"/></mxCell>
        <mxCell id="g-l7" value="out (N, P, C)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1EDFA;strokeColor=#5B8DB8;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="630" width="690" height="40" as="geometry"/></mxCell>
        <mxCell id="g-l8" value="&lt;b&gt;模型里每个 grid 算子都走这条路&lt;/b&gt;：无参数 node product、多项式 grid MLP、单分支 branch mixer——算的都是同一个核心表达式" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F7F7;strokeColor=#B9C6C9;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="694" width="690" height="60" as="geometry"/></mxCell>
        <mxCell id="g-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#7A8B8F;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="g-l1" target="g-l2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#7A8B8F;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="g-l2" target="g-l3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g-e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#7A8B8F;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="g-l4" target="g-l5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g-e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#7A8B8F;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="g-l5" target="g-l6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g-e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#7A8B8F;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="g-l6" target="g-l7"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="g-r1" value="&lt;b&gt;deepmd::dpa4_grid_pair&lt;/b&gt;&amp;nbsp;&amp;nbsp;（source/op/pt/dpa4/grid_pair.cu）&lt;br&gt;out = from_grid( to_grid(left) · to_grid(right) )&amp;nbsp;&amp;nbsp;一个核算完&lt;br&gt;一个 warp 沿 grid 点 g 游走，同时持有两个系数算子与输出累加器" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9F1EC;strokeColor=#3E8E7E;fontColor=#1F5C50;fontSize=13;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="790" y="140" width="850" height="86" as="geometry"/></mxCell>
        <mxCell id="g-r2" value="&lt;b&gt;寄存器驻留&lt;/b&gt;：lg、rg、输出累加器&lt;br&gt;grid 场从不离开寄存器 → 没有中间张量、也没有 layout copy&lt;br&gt;&lt;b&gt;设备访存降到两个输入 + 结果（理论下界）&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0D5;strokeColor=#D6A64A;fontColor=#6B4A12;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="790" y="250" width="850" height="72" as="geometry"/></mxCell>
        <mxCell id="g-r3" value="&lt;b&gt;两项资源同时成为约束&lt;/b&gt;（zoo 的 P = 12 / 27 / 48 / 75 / 108 跨度够大，两者都会碰到）&lt;br&gt;寄存器：一个 lane 持有整条系数向量需要 arrays × P 个，P = 108 的前向是 324 个&lt;br&gt;shared：暂存两个投影矩阵需 2 · G · P 个 float，P = 108 时 297 KB，超出任何一款卡" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F7F7;strokeColor=#B9C6C9;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="790" y="346" width="850" height="80" as="geometry"/></mxCell>
        <mxCell id="g-r4" value="&lt;b&gt;因此 warp 做二维切分&lt;/b&gt;：CPW 个通道 × GROUP 个系数切片&lt;br&gt;投影矩阵按 GB 行块分批暂存，块大小压在固定 shared 预算内&lt;br&gt;代价：每个 grid 点一次 log2(GROUP) 步 warp 归约；GROUP = 1（窄形状）完全不需要归约" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F7F7;strokeColor=#B9C6C9;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="790" y="450" width="850" height="80" as="geometry"/></mxCell>
        <mxCell id="g-r5" value="&lt;b&gt;数值&lt;/b&gt;：IEEE fp32；grid 求和按 g 的自然顺序，结果逐位可复现" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEE6FA;strokeColor=#8D7BB8;fontColor=#43356B;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="790" y="554" width="850" height="44" as="geometry"/></mxCell>
        <mxCell id="g-r6" value="&lt;b&gt;收益&lt;/b&gt;&amp;nbsp;属于『收益来自访存』这一类，所以在被测的每个 checkpoint 上都是正收益&lt;br&gt;整个 DP_CUDA_INFER=1（含本融合）相对基线 &lt;b&gt;1.04x – 1.29x&lt;/b&gt;，峰值显存同时下降&lt;br&gt;实测条件：RTX PRO 6000 Blackwell，基线 DP_TRITON_INFER=2 + DP_COMPILE_INFER=1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9F1EC;strokeColor=#3E8E7E;fontColor=#1F5C50;fontSize=13;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="790" y="622" width="850" height="80" as="geometry"/></mxCell>
        <mxCell id="g-r7" value="⚠ 上游两处数字不一致：doc/model/dpa4.md 写 grid 场『up to 39 times larger / 数百 MB』，而 grid_pair.cu 头部写『6–10 倍 / 2.1 GB』。此图取 kernel 源码的说法。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0D5;strokeColor=#D6A64A;fontColor=#6B4A12;fontSize=11;align=left;spacingLeft=12;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="790" y="726" width="850" height="56" as="geometry"/></mxCell>

        <mxCell id="g-foot" value="&lt;b&gt;三张图通用的前提&lt;/b&gt;&amp;nbsp;&amp;nbsp;① 所有倍数均为上游文档在 RTX PRO 6000 Blackwell 的实测值，未在本项目 K500SM_AI / HIP 环境验证。&amp;nbsp;&amp;nbsp;② 这些 native 算子只在 USE_CUDA_TOOLKIT 且 DEEPMD_TORCH_HAS_CUDA 下进入构建（source/op/pt/CMakeLists.txt），DCU 构建里 torch.ops.deepmd.* 不存在，dispatch 静默回退稠密参考路径。&amp;nbsp;&amp;nbsp;③ 开关在&lt;b&gt;模型构造时&lt;/b&gt;读取，之后修改无效。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F7F7;strokeColor=#B9C6C9;fontSize=11;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="810" width="1600" height="70" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="fusion-zonal-scatter" name="2 · GIE zonal scatter">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="z-title" value="&lt;b&gt;融合 2 / 几何初始嵌入（GIE）的消息构造 + 邻居归约&lt;/b&gt;&amp;nbsp;&amp;nbsp;deepmd::dpa4_zonal_scatter&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;DP_CUDA_INFER &amp;gt;= 1&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;融合动因：消息『写一次读一次』就被丢弃" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#203B43;strokeColor=#203B43;fontColor=#FFFFFF;fontSize=16;align=left;spacingLeft=16;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1600" height="50" as="geometry"/></mxCell>
        <mxCell id="z-form" value="两边算的是同一个式子：&amp;nbsp;&amp;nbsp;&lt;b&gt;out[n, r, c] = Σ&lt;sub&gt;dst[e] = n&lt;/sub&gt; zonal[e, r] · radial[e, slot[r], c]&lt;/b&gt;&amp;nbsp;&amp;nbsp;（R = (lmax+1)² − 1 个打包非标量行，按打包序承载 degree 1..lmax）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEE6FA;strokeColor=#8D7BB8;fontColor=#43356B;fontSize=13;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="84" width="1600" height="44" as="geometry"/></mxCell>
        <mxCell id="z-lh" value="&lt;b&gt;未融合：张量算子组合&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F9E5E1;strokeColor=#C96A5A;fontColor=#7A3326;fontSize=14;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="146" width="690" height="36" as="geometry"/></mxCell>
        <mxCell id="z-rh" value="&lt;b&gt;融合后：一个 warp 一个节点，消息留在寄存器&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D9F1EC;strokeColor=#3E8E7E;fontColor=#1F5C50;fontSize=14;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="790" y="146" width="850" height="36" as="geometry"/></mxCell>
        <mxCell id="z-div" style="endArrow=none;html=1;strokeColor=#B9C6C9;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="146" as="sourcePoint"/><mxPoint x="760" y="1010" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="z-l1" value="输入&lt;br&gt;zonal (E, R)&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;radial (E, n_degree, C)&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;dst (E)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1EDFA;strokeColor=#5B8DB8;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="690" height="50" as="geometry"/></mxCell>
        <mxCell id="z-l2" value="① 按 slot[r] 把每个打包非标量行的 radial 特征广播开&lt;br&gt;② 乘上该行的 zonal 耦合系数" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B9C6C9;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="274" width="690" height="58" as="geometry"/></mxCell>
        <mxCell id="z-l3" value="&lt;b&gt;物化逐边消息 (E, R, C)&lt;/b&gt;&lt;br&gt;生产形状下 &lt;b&gt;1.3 GB&lt;/b&gt;&lt;br&gt;写进 HBM 一次、被 scatter 读出一次，然后就丢弃" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9E5E1;strokeColor=#C96A5A;fontColor=#7A3326;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="356" width="690" height="70" as="geometry"/></mxCell>
        <mxCell id="z-l4" value="③ 按 dst 做 scatter / index_add 归约 → out (N, R, C)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B9C6C9;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="690" height="46" as="geometry"/></mxCell>
        <mxCell id="z-l5" value="行原子 scatter 的两个附带问题：&lt;br&gt;· 每原子约 10² 条碰撞边时原子写会串行化&lt;br&gt;· 求和顺序不确定 → 结果不逐位可复现" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9E5E1;strokeColor=#C96A5A;fontColor=#7A3326;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="690" height="70" as="geometry"/></mxCell>
        <mxCell id="z-l6" value="out (N, R, C)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1EDFA;strokeColor=#5B8DB8;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="614" width="690" height="40" as="geometry"/></mxCell>
        <mxCell id="z-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#7A8B8F;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="z-l1" target="z-l2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="z-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#7A8B8F;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="z-l2" target="z-l3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="z-e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#7A8B8F;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="z-l3" target="z-l4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="z-e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#7A8B8F;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="z-l5" target="z-l6"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="z-r1" value="&lt;b&gt;deepmd::dpa4_zonal_scatter&lt;/b&gt;&amp;nbsp;&amp;nbsp;（source/op/pt/dpa4/zonal_scatter.cu）&lt;br&gt;一个 warp 负责一个节点，沿&lt;b&gt;卷积已经建好的 destination CSR&lt;/b&gt; 走自己的入边表&lt;br&gt;消息只在寄存器里存在，直接累加进节点 tile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9F1EC;strokeColor=#3E8E7E;fontColor=#1F5C50;fontSize=13;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="790" y="200" width="850" height="86" as="geometry"/></mxCell>
        <mxCell id="z-r2" value="&lt;b&gt;设备访存降到：两个输入 + 节点输出&lt;/b&gt;&lt;br&gt;即 1.3 GB 的逐边消息完全不再产生——这就是全部收益来源" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0D5;strokeColor=#D6A64A;fontColor=#6B4A12;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="790" y="310" width="850" height="60" as="geometry"/></mxCell>
        <mxCell id="z-r3" value="&lt;b&gt;打包布局是让它成立的关键&lt;/b&gt;&lt;br&gt;行 r 复用 radial 的 degree slot[r]，同一 degree 的行连续&lt;br&gt;→ 对 radial 的重复读命中 L1，而不是反复回 HBM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F7F7;strokeColor=#B9C6C9;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="790" y="394" width="850" height="72" as="geometry"/></mxCell>
        <mxCell id="z-r4" value="&lt;b&gt;通道维的安排&lt;/b&gt;&lt;br&gt;一个 lane 拥有 32 宽 block 中的一个通道，整个行 tile 驻留寄存器&lt;br&gt;更宽的通道数就按 block 重扫一遍边表；因为每个 block 只读自己的通道，&lt;b&gt;设备访存不变&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F7F7;strokeColor=#B9C6C9;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="790" y="490" width="850" height="80" as="geometry"/></mxCell>
        <mxCell id="z-r5" value="&lt;b&gt;数值与同步&lt;/b&gt;：归约沿 CSR 顺序进行 → &lt;b&gt;不需要 atomics&lt;/b&gt;，且逐位可复现（顺带解决左边的串行化与不确定求和序）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEE6FA;strokeColor=#8D7BB8;fontColor=#43356B;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="790" y="594" width="850" height="56" as="geometry"/></mxCell>
        <mxCell id="z-r6" value="&lt;b&gt;收益&lt;/b&gt;&amp;nbsp;与融合 1 同属『收益来自访存』，在被测的每个 checkpoint 上都是正收益；&lt;br&gt;整个 DP_CUDA_INFER=1（含本融合）相对基线 &lt;b&gt;1.04x – 1.29x&lt;/b&gt;，峰值显存同时下降。&lt;br&gt;本项目 csrc/ 里的 GIE native 适配对标的就是这一段。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9F1EC;strokeColor=#3E8E7E;fontColor=#1F5C50;fontSize=13;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="790" y="674" width="850" height="80" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="fusion-so2-conv" name="3 · 整段 SO(2) 卷积">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="s-title" value="&lt;b&gt;融合 3 / 整段逐边 SO(2) 卷积&lt;/b&gt;&amp;nbsp;&amp;nbsp;deepmd::dpa4_so2_conv（fwd + bwd 一对算子）&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;DP_CUDA_INFER = 2&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;融合动因：整条流水线的中间量都是逐边的" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#203B43;strokeColor=#203B43;fontColor=#FFFFFF;fontSize=16;align=left;spacingLeft=16;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1600" height="50" as="geometry"/></mxCell>
        <mxCell id="s-lh" value="&lt;b&gt;未融合：9 个阶段，每个阶段都把 (E, ROW) 级别的激活落 HBM&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F9E5E1;strokeColor=#C96A5A;fontColor=#7A3326;fontSize=14;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="690" height="36" as="geometry"/></mxCell>
        <mxCell id="s-rh" value="&lt;b&gt;融合后：一对算子，逐边中间量一个都不到达显存&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D9F1EC;strokeColor=#3E8E7E;fontColor=#1F5C50;fontSize=14;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="790" y="90" width="850" height="36" as="geometry"/></mxCell>
        <mxCell id="s-div" style="endArrow=none;html=1;strokeColor=#B9C6C9;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="90" as="sourcePoint"/><mxPoint x="760" y="1090" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="s-l0" value="输入：节点特征 x、边四元数 q、radial、envelope、src / dst" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1EDFA;strokeColor=#5B8DB8;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="690" height="40" as="geometry"/></mxCell>
        <mxCell id="s-l1" value="① gather 源节点特征 → 逐边激活" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B9C6C9;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="196" width="690" height="34" as="geometry"/></mxCell>
        <mxCell id="s-l2" value="② 稠密 Wigner-D 构建：单项式基 → 每个 degree 一次 GEMM → index_put_ 填进补零的块对角帧 → 转置拷贝&lt;br&gt;&lt;b&gt;共 5 趟全尺寸 (E, D, D) 遍历&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9E5E1;strokeColor=#C96A5A;fontColor=#7A3326;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="244" width="690" height="62" as="geometry"/></mxCell>
        <mxCell id="s-l3" value="③ rotate_to_local：按 Wigner 矩阵旋转到局部坐标" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B9C6C9;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="690" height="34" as="geometry"/></mxCell>
        <mxCell id="s-l4" value="④ radial degree mixer（边条件混合）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B9C6C9;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="368" width="690" height="34" as="geometry"/></mxCell>
        <mxCell id="s-l5" value="⑤ 门控 mixing stack：n_layers − 1 个门控层 + 1 个 identity 层&lt;br&gt;&lt;b&gt;每一层的激活都是一个独立的逐边张量&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9E5E1;strokeColor=#C96A5A;fontColor=#7A3326;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="416" width="690" height="56" as="geometry"/></mxCell>
        <mxCell id="s-l6" value="⑥ 逆旋转（回到全局坐标）&amp;nbsp;&amp;nbsp;+&amp;nbsp;&amp;nbsp;degree rescale" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B9C6C9;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="486" width="690" height="34" as="geometry"/></mxCell>
        <mxCell id="s-l7" value="⑦ attention logits + envelope 门控分段 softmax → alpha&amp;nbsp;&amp;nbsp;（⑧ alpha 加权）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B9C6C9;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="534" width="690" height="34" as="geometry"/></mxCell>
        <mxCell id="s-l8" value="⑨ 按 dst 做 index_add 归约&amp;nbsp;&amp;nbsp;+&amp;nbsp;&amp;nbsp;输出 head gate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B9C6C9;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="582" width="690" height="34" as="geometry"/></mxCell>
        <mxCell id="s-l9" value="out (N, D, C)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1EDFA;strokeColor=#5B8DB8;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="630" width="690" height="36" as="geometry"/></mxCell>
        <mxCell id="s-lnote" value="&lt;b&gt;代价集中在访存&lt;/b&gt;：这条路径同时是整个 SeZM 推理步的时间与激活显存大头；&lt;br&gt;每个阶段边界都意味着一次 (E, ROW) 级别的写 + 读。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9E5E1;strokeColor=#C96A5A;fontColor=#7A3326;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="684" width="690" height="60" as="geometry"/></mxCell>

        <mxCell id="s-r1" value="&lt;b&gt;deepmd::dpa4_so2_conv&lt;/b&gt;&amp;nbsp;&amp;nbsp;（source/op/pt/dpa4/so2_conv*.cu / .cuh）&lt;br&gt;①–⑨ 全部进同一对算子（前向 + 反向），按 focus 宽度 × lmax 特化实例化：&lt;br&gt;so2_conv_{fwd,bwd}_c{32,64}_l{1..6}.cu&amp;nbsp;&amp;nbsp;（12 + 12 个特化）&lt;br&gt;&lt;b&gt;没有任何逐边中间量到达显存&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9F1EC;strokeColor=#3E8E7E;fontColor=#1F5C50;fontSize=13;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="790" y="140" width="850" height="100" as="geometry"/></mxCell>
        <mxCell id="s-r2" value="&lt;b&gt;布局设计一：m-major reduced 布局&lt;/b&gt;&lt;br&gt;每条边每个 focus 流携带 RED = 3·lmax + 1 行（m = 0 / −1 / +1 三段）&lt;br&gt;前 M0 = (lmax+1)·Cf 列是 m = 0 块，其余 M1 = 2·lmax·Cf 是两个 |m| = 1 块&lt;br&gt;→ SO(2) 混合权重在这个划分上&lt;b&gt;块对角&lt;/b&gt;，整个 stack 退化成两次独立乘法 + 一个共享门" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0D5;strokeColor=#D6A64A;fontColor=#6B4A12;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="790" y="264" width="850" height="100" as="geometry"/></mxCell>
        <mxCell id="s-r3" value="&lt;b&gt;布局设计二：列归属规则&lt;/b&gt;&lt;br&gt;输出列 j·32 + lane 固定归 lane 所有，j = r·CFB + cb（CFB = Cf/32）&lt;br&gt;→ &lt;b&gt;同一个寄存器数组同时服务块乘法、旋转和门控，无任何跨 lane 通信&lt;/b&gt;&lt;br&gt;→ 激活、门 sigmoid、节点累加器全部常驻寄存器" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0D5;strokeColor=#D6A64A;fontColor=#6B4A12;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="790" y="388" width="850" height="92" as="geometry"/></mxCell>
        <mxCell id="s-r4" value="&lt;b&gt;顺带消掉阶段 ②&lt;/b&gt;：Wigner 旋转直接从边四元数按拟合稀疏多项式生成（wigner_dense.cu 同一思路），&lt;br&gt;稠密逐边矩阵完全不再存在；只读取每个被选行的 degree 块里 2l+1 个非零元，按边打包成 NW = 3(lmax+1)² − 2 的 float 串" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F7F7;strokeColor=#B9C6C9;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="790" y="504" width="850" height="76" as="geometry"/></mxCell>
        <mxCell id="s-r5" value="CSR 拓扑在 C++ 侧自行推导，而不是作为参数传入——否则 Python 包装需要把节点数当 Python int，会把 trace 期的节点数烘进编译图。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F7F7;strokeColor=#B9C6C9;fontSize=11;align=left;spacingLeft=12;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="790" y="604" width="850" height="52" as="geometry"/></mxCell>
        <mxCell id="s-r6" value="&lt;b&gt;收益（RTX PRO 6000 Blackwell，基线 DP_TRITON_INFER=2 + DP_COMPILE_INFER=1）&lt;/b&gt;&lt;br&gt;nano（l1 c32）&amp;nbsp;&lt;b&gt;1.64x&lt;/b&gt;，峰值 6.2 GiB（降 1.23x）&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;mini（l2 c32）&amp;nbsp;&lt;b&gt;1.77x&lt;/b&gt;，峰值 10.1 GiB（降 1.53x）&lt;br&gt;neo / air / plus / pro：路由器拒绝该融合，退回 level 1 行为（1.04x – 1.15x），峰值仍下降 1.05x – 1.53x" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9F1EC;strokeColor=#3E8E7E;fontColor=#1F5C50;fontSize=13;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="790" y="680" width="850" height="90" as="geometry"/></mxCell>
        <mxCell id="s-r7" value="&lt;b&gt;为什么要路由&lt;/b&gt;：这个融合是用 float32 算力换访存，所以&lt;b&gt;逐边算力越大、收益越小&lt;/b&gt;。&lt;br&gt;逐边算力超过固定阈值的 block 留在 Triton 路径 → level 2 &lt;b&gt;不会比 level 1 慢&lt;/b&gt;，可以无条件开。&lt;br&gt;被接管的卷积上，DP_TRITON_INFER=3 的 fp16x3 GEMM 不再运行，于是 Triton 两级重合。&lt;br&gt;在 float32 峰值只有这张卡 1/3 的 H20 上，阈值不会放过任何 checkpoint，那里 level 1 才是有效设置。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F7F7;strokeColor=#B9C6C9;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="790" y="794" width="850" height="96" as="geometry"/></mxCell>
        <mxCell id="s-r8" value="&lt;b&gt;精度代价&lt;/b&gt;：最大力偏差约 1e-5 eV/Å，来自融合归约的求和顺序（两级相同；算子本身是精确 fp32、TF32 关闭）。&lt;br&gt;&lt;b&gt;可部署性&lt;/b&gt;：两级都是 make_fx 可追踪的预编译自定义算子，会烘进 frozen .pt2，被 ASE / LAMMPS 载入后仍然生效。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEE6FA;strokeColor=#8D7BB8;fontColor=#43356B;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="790" y="914" width="850" height="70" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
