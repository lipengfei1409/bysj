*.py[cod]
build/
dist/
*.egg-info/
*.so
*.dylib

# torch's hipify step writes these *inside the source tree* before compiling, so
# they are build output that happens to live next to the sources.  Leaving them
# behind after a change of arch or headers makes the next build compile stale code.
*_hip.cpp
*_hip.h
.pytest_cache/
test-results/
