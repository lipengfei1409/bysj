# DCU profiling paths for this checkout.
#
#   source tests/deepmd/profile/dcu_paths.env
#
# MODEL: DPA4-Air-OMol25-100M.  "Air" is also the checkpoint whose per-edge
#        mixing layer costs 225.3 kFMA -- the point where upstream's own
#        calibration says the fused SO(2) convolution loses 9% against the
#        Triton composition (see docs/execution-model.md 4.5).
# NPZ:   3000-atom SPC/E water box, the shape the trace was taken at
#        (181838 edges over 3000 atoms).
export MODEL=/root/private_data/lipengfei/model/DPA4-OMol/DPA4-Air-OMol25-100M-v20260820.pt
export NPZ=/root/private_data/lipengfei/test_result/water_spce_3000.npz
export OUT=/root/private_data/lipengfei/test_result/verify
