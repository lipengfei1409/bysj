          <mxGeometry x="40" y="24" width="1600" height="48" as="geometry" />
        </mxCell>
        <mxCell id="so3" value="仓库实现范围：lmax=mmax=1，FP32、HIP/DCU standalone kernels。实线描述源文件中可核对的局部算子输入 / 输出；reshape、层级编排与完整 DeepMD dispatch 不在此仓库中证明。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0D5;strokeColor=#C88729;fontColor=#15323B;fontSize=13;align=left;verticalAlign=middle;spacing=8;fontStyle=0;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
