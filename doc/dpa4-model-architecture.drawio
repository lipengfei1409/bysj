  <diagram id="gie-dataflow" name="GIE 数据流">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1120" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="gie2" value="&lt;b&gt;GIE / 几何初始嵌入：仓库可核对的数据流&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#203B43;strokeColor=#203B43;fontColor=#FFFFFF;fontSize=23;align=center;verticalAlign=middle;spacing=8;fontStyle=1;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="1600" height="48" as="geometry" />
        </mxCell>
        <mxCell id="gie3" value="两个 standalone 分支分别画出：zonal scatter 与 environment-seed。它们是算子级计算图，不推断完整 DeepMD 模型中二者的相对调用顺序。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0D5;strokeColor=#C88729;fontColor=#15323B;fontSize=13;align=left;verticalAlign=middle;spacing=8;fontStyle=0;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="84" width="1600" height="54" as="geometry" />
        </mxCell>
        <mxCell id="gie4" value="&lt;b&gt;分支 A · zonal scatter&lt;/b&gt;  [python/kernels/tilelang_ops/zonal_scatter.py]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9F1EC;strokeColor=#288779;fontColor=#15323B;fontSize=16;align=left;verticalAlign=middle;spacing=8;fontStyle=1;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="1600" height="42" as="geometry" />
        </mxCell>
        <mxCell id="gie5" value="&lt;b&gt;zonal coupling&lt;/b&gt;&lt;br&gt;z[E,R]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1EDFA;strokeColor=#4C78A8;fontColor=#15323B;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontStyle=0;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="50" y="245" width="190" height="100" as="geometry" />
        </mxCell>
        <mxCell id="gie6" value="&lt;b&gt;radial features&lt;/b&gt;&lt;br&gt;radial[E,S,C]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1EDFA;strokeColor=#4C78A8;fontColor=#15323B;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontStyle=0;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="50" y="370" width="190" height="100" as="geometry" />
        </mxCell>
        <mxCell id="gie7" value="&lt;b&gt;索引 / 归一化&lt;/b&gt;&lt;br&gt;dst[E]&lt;br&gt;radial_slot[R]&lt;br&gt;d⁻¹ᐟ²[N]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1EDFA;strokeColor=#4C78A8;fontColor=#15323B;fontSize=13;align=center;verticalAlign=middle;spacing=8;fontStyle=0;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="280" y="280" width="205" height="150" as="geometry" />
        </mxCell>
        <mxCell id="gie8" value="&lt;b&gt;按边 e 与 zonal 行 r 计算&lt;/b&gt;&lt;br&gt;slot = radial_slot[r]&lt;br&gt;n = dst[e]&lt;br&gt;&lt;br&gt;Δ = zonal[e,r] × radial[e,slot,:] × d⁻¹ᐟ²[n]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0D5;strokeColor=#C88729;fontColor=#15323B;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontStyle=0;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="545" y="265" width="430" height="180" as="geometry" />
        </mxCell>
        <mxCell id="gie9" value="&lt;b&gt;目标节点累加&lt;/b&gt;&lt;br&gt;Y[N,R+1,C]，初始化为 0&lt;br&gt;Y[n,r+1,:] += Δ&lt;br&gt;r=0 留作保留行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9E5E1;strokeColor=#C86C62;fontColor=#15323B;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontStyle=0;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1040" y="270" width="300" height="160" as="geometry" />
        </mxCell>
        <mxCell id="gie10" value="zonal[e,r]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#52747C;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;fontColor=#526B73;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="gie5" target="gie8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gie11" value="radial lookup" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#52747C;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;fontColor=#526B73;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="gie6" target="gie8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gie12" value="dst / slot / norm" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#52747C;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;fontColor=#526B73;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="gie7" target="gie8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gie13" value="scatter-add" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#52747C;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;fontColor=#526B73;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="gie8" target="gie9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gie14" value="等价标量式：Y[dst[e], r+1, c] += zonal[e,r] · radial[e, radial_slot[r], c] · inv_sqrt_deg[dst[e]]。对共享目标节点的入边做累加。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F7F7;strokeColor=#B6C8CA;fontColor=#15323B;fontSize=13;align=left;verticalAlign=middle;spacing=8;fontStyle=0;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="50" y="465" width="1290" height="55" as="geometry" />
        </mxCell>
        <mxCell id="gie15" value="&lt;b&gt;分支 B · environment-seed matrix → scatter → invariant Gram&lt;/b&gt;  [environment_matrix.py · env_seed_scatter.py · env_seed_gram.py]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9F1EC;strokeColor=#288779;fontColor=#15323B;fontSize=16;align=left;verticalAlign=middle;spacing=8;fontStyle=1;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="555" width="1600" height="42" as="geometry" />
        </mxCell>
        <mxCell id="gie16" value="&lt;b&gt;边几何&lt;/b&gt;&lt;br&gt;edge_vec[E,3]&lt;br&gt;edge_env[E,1]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1EDFA;strokeColor=#4C78A8;fontColor=#15323B;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontStyle=0;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="50" y="645" width="205" height="115" as="geometry" />
        </mxCell>
        <mxCell id="gie17" value="&lt;b&gt;环境几何通道&lt;/b&gt;&lt;br&gt;inv_r = 1/√(||v||²+ε²)&lt;br&gt;a = edge_env × inv_r&lt;br&gt;r̃ = [a, a·v·inv_r]&lt;br&gt;r̃[E,4]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0D5;strokeColor=#C88729;fontColor=#15323B;fontSize=13;align=center;verticalAlign=middle;spacing=8;fontStyle=0;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="320" y="620" width="305" height="165" as="geometry" />
        </mxCell>
        <mxCell id="gie18" value="&lt;b&gt;边 embedding 与索引&lt;/b&gt;&lt;br&gt;features[E,D]&lt;br&gt;dst[E]&lt;br&gt;inv_sqrt_deg[N]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1EDFA;strokeColor=#4C78A8;fontColor=#15323B;fontSize=13;align=center;verticalAlign=middle;spacing=8;fontStyle=0;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="690" y="640" width="245" height="125" as="geometry" />
        </mxCell>
        <mxCell id="gie19" value="&lt;b&gt;degree-normalized outer-product scatter&lt;/b&gt;&lt;br&gt;M[dst[e],j,k] += r̃[e,j] × features[e,k] × inv_sqrt_deg[dst[e]]&lt;br&gt;&lt;br&gt;M[N,4,D]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9E5E1;strokeColor=#C86C62;fontColor=#15323B;fontSize=13;align=center;verticalAlign=middle;spacing=8;fontStyle=0;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="990" y="620" width="360" height="165" as="geometry" />
        </mxCell>
        <mxCell id="gie20" value="&lt;b&gt;不变量 Gram 投影&lt;/b&gt;&lt;br&gt;G = Mᵀ · M[..., :A]&lt;br&gt;G[N,D,A]&lt;br&gt;A = axis_dim ≤ D" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEE6FA;strokeColor=#8064A2;fontColor=#15323B;fontSize=13;align=center;verticalAlign=middle;spacing=8;fontStyle=0;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1390" y="640" width="240" height="125" as="geometry" />
        </mxCell>
        <mxCell id="gie21" value="向量与 envelope" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#52747C;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;fontColor=#526B73;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="gie16" target="gie17">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gie22" value="r̃[e,j]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#52747C;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;fontColor=#526B73;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="gie17" target="gie19">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gie23" value="features / dst / degree" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#52747C;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;fontColor=#526B73;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="gie18" target="gie19">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gie24" value="节点环境矩阵" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#52747C;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;fontColor=#526B73;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="gie19" target="gie20">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gie25" value="逐节点公式：G[n,d,a] = Σⱼ₌₀³ M[n,j,d] · M[n,j,a]（第二个轴截取前 A 个 embedding 方向）。输出是对局部坐标轴的 invariant Gram projection。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F7F7;strokeColor=#B6C8CA;fontColor=#15323B;fontSize=13;align=left;verticalAlign=middle;spacing=8;fontStyle=0;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="50" y="830" width="1580" height="65" as="geometry" />
        </mxCell>
        <mxCell id="gie26" value="&lt;b&gt;源码边界&lt;/b&gt;&lt;br&gt;本页公式来自项目独立 TileLang kernel/reference，不表示 DeepMD DPA4 会自动选择这些算子。DeepMD snapshot 的 _run_graph 顺序为可选 Env FiLM → GIE → interaction blocks（deepmd/dpmodel/descriptor/dpa4.py:1626–1727）；use_env_seed / use_gie 等分支由模型配置控制。详见“DeepMD 源码出处”页。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0D5;strokeColor=#C88729;fontColor=#15323B;fontSize=13;align=left;verticalAlign=middle;spacing=8;fontStyle=0;dashed=1;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="50" y="930" width="1580" height="84" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="emfa-so2" name="EMFA SO(2)">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1120" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="so2" value="&lt;b&gt;EMFA SO(2) 卷积：局部 frame 中的算子数据流&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#203B43;strokeColor=#203B43;fontColor=#FFFFFF;fontSize=23;align=center;verticalAlign=middle;spacing=8;fontStyle=1;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="1600" height="48" as="geometry" />
        </mxCell>
        <mxCell id="so3" value="仓库实现范围：lmax=mmax=1，FP32、HIP/DCU standalone kernels。实线描述源文件中可核对的局部算子输入 / 输出；reshape、层级编排与完整 DeepMD dispatch 不在此仓库中证明。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0D5;strokeColor=#C88729;fontColor=#15323B;fontSize=13;align=left;verticalAlign=middle;spacing=8;fontStyle=0;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="84" width="1600" height="58" as="geometry" />
        </mxCell>
        <mxCell id="so4" value="&lt;b&gt;边向量&lt;/b&gt;&lt;br&gt;v[e] ∈ R³&lt;br&gt;可选缓存长度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1EDFA;strokeColor=#4C78A8;fontColor=#15323B;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontStyle=0;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="45" y="230" width="190" height="105" as="geometry" />
        </mxCell>
        <mxCell id="so5" value="&lt;b&gt;edge quaternion&lt;/b&gt;&lt;br&gt;q[E,4]&lt;br&gt;平滑 two-chart 构造&lt;br&gt;edge_quaternion.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9F1EC;strokeColor=#288779;fontColor=#15323B;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontStyle=0;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="285" y="215" width="250" height="135" as="geometry" />
        </mxCell>
        <mxCell id="so6" value="&lt;b&gt;packed l=0 / l=1 Wigner-D&lt;/b&gt;&lt;br&gt;D[E,4,4] 与 Dᵀ[E,4,4]&lt;br&gt;wigner_l1.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9F1EC;strokeColor=#288779;fontColor=#15323B;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontStyle=0;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="585" y="215" width="285" height="135" as="geometry" />
        </mxCell>
        <mxCell id="so7" value="几何" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#52747C;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;fontColor=#526B73;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="so4" target="so5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="so8" value="q" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#52747C;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;fontColor=#526B73;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="so5" target="so6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="so9" value="&lt;b&gt;节点特征&lt;/b&gt;&lt;br&gt;X[N,4,C]&lt;br&gt;源索引 src[E]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1EDFA;strokeColor=#4C78A8;fontColor=#15323B;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontStyle=0;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="45" y="430" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="so10" value="&lt;b&gt;gather + rotate to local&lt;/b&gt;&lt;br&gt;X_local[e] = P·D[e]·X[src[e]]&lt;br&gt;X_local[E,4,C]&lt;br&gt;so2_rotate_to_local_l1.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0D5;strokeColor=#C88729;fontColor=#15323B;fontSize=13;align=center;verticalAlign=middle;spacing=8;fontStyle=0;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="345" y="405" width="365" height="165" as="geometry" />
        </mxCell>
        <mxCell id="so11" value="D" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#52747C;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;fontColor=#526B73;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="so6" target="so10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="so12" value="X, src" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#52747C;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;fontColor=#526B73;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="so9" target="so10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="so13" value="&lt;b&gt;径向调制系数&lt;/b&gt;&lt;br&gt;R[E,M,C]&lt;br&gt;由 radial / degree 路径提供" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1EDFA;strokeColor=#4C78A8;fontColor=#15323B;fontSize=13;align=center;verticalAlign=middle;spacing=8;fontStyle=0;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="45" y="690" width="255" height="125" as="geometry" />
        </mxCell>
        <mxCell id="so14" value="&lt;b&gt;elementwise radial scale&lt;/b&gt;&lt;br&gt;V[e,m,c] = X_local[e,m,c] × R[e,m,c]&lt;br&gt;so2_radial_scale.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9F1EC;strokeColor=#288779;fontColor=#15323B;fontSize=13;align=center;verticalAlign=middle;spacing=8;fontStyle=0;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="345" y="675" width="365" height="155" as="geometry" />
        </mxCell>
        <mxCell id="so15" value="local features" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#52747C;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;fontColor=#526B73;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="so10" target="so14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="so16" value="radial weights" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#52747C;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;fontColor=#526B73;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="so13" target="so14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="so17" value="&lt;b&gt;block-diagonal SO2Linear&lt;/b&gt;&lt;br&gt;两个等宽 |m| blocks 独立收缩；不做跨 block 混合&lt;br&gt;Y₀ = X₀W₀；Y₁ = X₁W₁&lt;br&gt;so2_linear_l1.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEE6FA;strokeColor=#8064A2;fontColor=#15323B;fontSize=13;align=center;verticalAlign=middle;spacing=8;fontStyle=0;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="790" y="665" width="365" height="175" as="geometry" />
        </mxCell>
        <mxCell id="so18" value="按 focus / m 分组的局部特征" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#52747C;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;fontColor=#526B73;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="so14" target="so17">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="so19" value="&lt;b&gt;rotate back to global&lt;/b&gt;&lt;br&gt;应用 Dᵀ / 逆变换&lt;br&gt;边输出 X_global[E,4,F·C]&lt;br&gt;so2_rotate_back_l1.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9E5E1;strokeColor=#C86C62;fontColor=#15323B;fontSize=13;align=center;verticalAlign=middle;spacing=8;fontStyle=0;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1235" y="665" width="360" height="175" as="geometry" />
        </mxCell>
        <mxCell id="so20" value="Dᵀ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#52747C;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;fontColor=#526B73;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="so6" target="so19">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="so21" value="SO(2) 输出" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#52747C;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;fontColor=#526B73;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="so17" target="so19">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="so22" value="&lt;b&gt;source 形状约束&lt;/b&gt;&lt;br&gt;rotate-to-local：X[N,4,C] + D[E,4,4] + src[E] → [E,4,C]&lt;br&gt;radial scale：values / radial 同形 [E,M,C]，逐元素相乘&lt;br&gt;SO2Linear：X[F,E,I] × W[I,F,O] → Y[F,E,O]；权重冻结时仅 feature path 参与反向&lt;br&gt;rotate-back：局部特征按 [E,F,4,C] 布局输入，输出 [E,4,F·C]。层间 layout / reshape 由调用方组织。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F7F7;strokeColor=#B6C8CA;fontColor=#15323B;fontSize=12;align=left;verticalAlign=middle;spacing=8;fontStyle=0;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="45" y="875" width="1070" height="150" as="geometry" />
        </mxCell>
        <mxCell id="so23" value="&lt;b&gt;源码边界&lt;/b&gt;&lt;br&gt;本图的 local-frame 主路径对应 DeepMD SO2Convolution.so2_message/_rotate_mix 和 SeZMInteractionBlock residual path；pt_expt 可以融合/替换局部算子。attention、mixing 与激活分支随配置变化；代码位置见“DeepMD 源码出处”页。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0D5;strokeColor=#C88729;fontColor=#15323B;fontSize=13;align=left;verticalAlign=middle;spacing=8;fontStyle=0;dashed=1;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1150" y="875" width="445" height="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="deepmd-source-map" name="DeepMD 源码出处">
    <mxGraphModel dx="1680" dy="1160" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1120" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="dsrc-title" value="DeepMD SeZM：模块、函数与源码出处" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#203B43;strokeColor=#203B43;fontColor=#FFFFFF;fontSize=23;align=center;verticalAlign=middle;spacing=8;fontStyle=1;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1600" height="48" as="geometry" />
        </mxCell>
        <mxCell id="dsrc-revision" value="源码快照：相邻目录 ../deepmd-kit（相对 myproject 根目录），branch feature/remove-dpa4-tilelang-dispatch，commit 8a33872b。以下路径和行号对应此快照；dpmodel 定义模型方程 / 调用链，pt_expt 提供 PyTorch runtime 映射与非 TileLang kernel override。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0D5;strokeColor=#C88729;fontColor=#15323B;fontSize=12;align=left;verticalAlign=middle;spacing=10;dashed=1;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="82" width="1600" height="62" as="geometry" />
        </mxCell>
        <mxCell id="dsrc-entry" value="&lt;b&gt;1 · 推理入口与 descriptor 图构建&lt;/b&gt;&lt;br&gt;本仓库适配层：python/model/dpa4.py::_create_deep_pot (58–68) → DeepPot。&lt;br&gt;DeepMD pt_expt 注册：deepmd/pt_expt/descriptor/dpa4.py:234–248；DescrptDPA4.forward:478–479 → self.call；该类继承 dpmodel descriptor。&lt;br&gt;核心方程 / 执行大纲：deepmd/dpmodel/descriptor/dpa4.py::DescrptDPA4 (234–290)；call (1276–1388) → _run_graph (1477–1555)。输入 coord / atype / nlist。&lt;br&gt;邻接图与 edge cache：dpa4.py:1348–1388、1559–1611；deepmd/dpmodel/descriptor/dpa4_nn/edge_cache.py::EdgeCache (53), _edge_cache_from_arrays (262–425)。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1EDFA;strokeColor=#4C78A8;fontColor=#15323B;fontSize=12;align=left;verticalAlign=top;spacing=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="165" width="770" height="300" as="geometry" />
        </mxCell>
        <mxCell id="dsrc-init" value="&lt;b&gt;2 · type / radial / Env seed / GIE 初始化&lt;/b&gt;&lt;br&gt;l=0 type embedding：SeZMTypeEmbedding.call — deepmd/dpmodel/descriptor/dpa4_nn/embedding.py:71–150；调用点 dpa4.py:1559–1575。&lt;br&gt;径向特征：RadialBasis.call — dpa4_nn/radial.py:457–590；RadialMLP.call — radial.py:51–155；组装于 dpa4.py:1617–1628。&lt;br&gt;可选环境 FiLM（不同于 GIE）：EnvironmentInitialEmbedding.call — embedding.py:438–804；dpa4.py:1630–1663。环境矩阵 / 聚合 / Gram 生成 scale、shift。&lt;br&gt;可选 GIE（几何 ℓ&gt;0 初始化）：GeometricInitialEmbedding.call — embedding.py:214–418；dpa4.py:1678–1697。pt_expt scatter override：deepmd/pt_expt/descriptor/dpa4_nn/embedding.py:48–120。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9F1EC;strokeColor=#288779;fontColor=#15323B;fontSize=12;align=left;verticalAlign=top;spacing=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="850" y="165" width="770" height="300" as="geometry" />
        </mxCell>
        <mxCell id="dsrc-blocks" value="&lt;b&gt;3 · 重复的 SeZM interaction blocks&lt;/b&gt;&lt;br&gt;descriptor._forward_blocks (dpa4.py:1743–1784) 依次调用 self.blocks。SeZMInteractionBlock.call — dpa4_nn/block.py:644–690。&lt;br&gt;基线残差路径：block.py:804–849，SO(2) unit 后接 equivariant FFN subblocks；具体数目和 schedules 来自 descriptor 配置。&lt;br&gt;SO2Convolution.call — dpa4_nn/so2.py:1635–1681；edge message / local-frame path so2_message (2328–2405)、_rotate_to_local (2570–2606)、_rotate_mix (2608–2677)、_rotate_back (2683–)。&lt;br&gt;attention 可选：attention_weights / _attention_softmax — so2.py:2055–2168。EquivariantFFN.call — dpa4_nn/ffn.py:52–70、264–279。pt_expt runtime wrappers 位于 deepmd/pt_expt/descriptor/dpa4_nn/{block,so2}.py。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEE6FA;strokeColor=#8064A2;fontColor=#15323B;fontSize=12;align=left;verticalAlign=top;spacing=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="500" width="770" height="360" as="geometry" />
        </mxCell>
        <mxCell id="dsrc-output" value="&lt;b&gt;4 · invariant readout、fitting 与能量导数&lt;/b&gt;&lt;br&gt;scalar descriptor readout：DescrptDPA4._apply_readout — deepmd/dpmodel/descriptor/dpa4.py:1863–1906；默认 none 仅保留 ℓ=0，其他模式可把高阶系数折入标量。&lt;br&gt;SeZM fitting：SeZMEnergyFittingNet — deepmd/dpmodel/fitting/dpa4_ener.py:357–424；GLUFittingNet.call:170–172。pt_expt fitting dispatch：deepmd/pt_expt/fitting/dpa4_ener.py:65–70。&lt;br&gt;模型注册：DPA4EnergyModel — deepmd/dpmodel/model/dpa4_model.py:18–26；pt_expt model registry — deepmd/pt_expt/model/dpa4_model.py:35–42。&lt;br&gt;EnergyModel.call — deepmd/dpmodel/model/ener_model.py:88–137；pt_expt EnergyModel.forward — deepmd/pt_expt/model/ener_model.py:328–382，负责 energy / force / virial 输出路径。&lt;br&gt;这部分是 DeepMD 端完整模型路径；本仓库 DPA4Model 加载 DeepPot 后默认仅对 eager pt_expt .pt 模型的 GIE 与 plain RMSNorm 安装原生 HIP/DCU patch；适配器不调用 TileLang，native_ops=() 可显式选择 DeepMD baseline。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9E5E1;strokeColor=#C86C62;fontColor=#15323B;fontSize=12;align=left;verticalAlign=top;spacing=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="850" y="500" width="770" height="360" as="geometry" />
        </mxCell>
        <mxCell id="dsrc-caveat" value="&lt;b&gt;阅读边界&lt;/b&gt;&lt;br&gt;源码可确认模块及函数的调用关系；但 n_blocks、channels、lmax/mmax、use_env_seed、use_gie、attention heads、SO(3) readout、FFN 与 radial 参数均由实际 checkpoint/config 决定。GIE 与 Env seed 是两个独立模块；图中的“EMFA SO(2)”在 DeepMD 源码中对应 SO2Convolution。DPA4 主实现位于 deepmd/dpmodel/descriptor/dpa4_nn，PyTorch runtime wrappers / overrides 位于 deepmd/pt_expt/descriptor/dpa4_nn；这与旧版 PyTorch SeZM 路径 deepmd/pt/model/descriptor/sezm_nn（旧版 GIE 示例：deepmd/pt/model/descriptor/sezm_nn/embedding.py::GeometricInitialEmbedding）是不同实现路径，旧路径不是本图映射的 DPA4 实现。本仓库 HIP zonal_scatter （python/kernels/gie.py → csrc/gie.cpp）只实现 GIE scatter primitive；DPA4Model 默认在 eager pt_expt .pt 模型中对支持的 GIE 调用安装 per-instance patch，但它不是 DeepMD GeometricInitialEmbedding 整模块的直接替换，不负责 Wigner-D / zonal coupling 生成、source gate、spin message 或 padded-edge mask；不支持的调用继续走 DeepMD 原实现。源码快照更新后，行号可能变化。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0D5;strokeColor=#C88729;fontColor=#15323B;fontSize=12;align=left;verticalAlign=middle;spacing=10;dashed=1;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="895" width="1600" height="130" as="geometry" />
        </mxCell>
      </root>
