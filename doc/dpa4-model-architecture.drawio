        </mxCell>
        <mxCell id="so4" value="&lt;b&gt;边向量&lt;/b&gt;&lt;br&gt;v[e] ∈ R³&lt;br&gt;可选缓存长度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1EDFA;strokeColor=#4C78A8;fontColor=#15323B;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontStyle=0;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
