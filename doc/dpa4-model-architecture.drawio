        </mxCell>
        <mxCell id="so5" value="&lt;b&gt;edge quaternion&lt;/b&gt;&lt;br&gt;q[E,4]&lt;br&gt;平滑 two-chart 构造&lt;br&gt;edge_quaternion.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9F1EC;strokeColor=#288779;fontColor=#15323B;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontStyle=0;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="285" y="215" width="250" height="135" as="geometry" />
