          <mxGeometry x="40" y="675" width="360" height="155" as="geometry" />
        </mxCell>
        <mxCell id="ov23" value="&lt;b&gt;旋转准备&lt;/b&gt;&lt;br&gt;edge_quaternion&lt;br&gt;wigner_l1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9F1EC;strokeColor=#288779;fontColor=#15323B;fontSize=13;align=center;verticalAlign=middle;spacing=8;fontStyle=0;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="430" y="675" width="250" height="155" as="geometry" />
        </mxCell>
        <mxCell id="ov24" value="&lt;b&gt;初始嵌入（两个独立模块）&lt;/b&gt;&lt;br&gt;GIE：GeometricInitialEmbedding / zonal scatter（ℓ&gt;0）&lt;br&gt;Env seed：EnvironmentInitialEmbedding / matrix → Gram → FiLM（l=0，可选）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9F1EC;strokeColor=#288779;fontColor=#15323B;fontSize=13;align=center;verticalAlign=middle;spacing=8;fontStyle=0;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="710" y="675" width="330" height="155" as="geometry" />
        </mxCell>
        <mxCell id="ov25" value="&lt;b&gt;DeepMD SO(2) convolution&lt;/b&gt;&lt;br&gt;SO2Convolution：rotate to local → radial mix → SO2Linear → rotate back&lt;br&gt;destination aggregation / attention 由配置选择" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEE6FA;strokeColor=#8064A2;fontColor=#15323B;fontSize=13;align=center;verticalAlign=middle;spacing=8;fontStyle=0;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1070" y="675" width="320" height="155" as="geometry" />
