        <mxCell id="ov10" value="&lt;b&gt;初始节点嵌入&lt;/b&gt;&lt;br&gt;SeZMTypeEmbedding → l=0&lt;br&gt;可选 EnvironmentInitialEmbedding → FiLM&lt;br&gt;GeometricInitialEmbedding / GIE → l&gt;0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9F1EC;strokeColor=#288779;fontColor=#15323B;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontStyle=0;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
