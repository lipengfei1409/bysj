        <mxCell id="so14" value="&lt;b&gt;elementwise radial scale&lt;/b&gt;&lt;br&gt;V[e,m,c] = X_local[e,m,c] × R[e,m,c]&lt;br&gt;so2_radial_scale.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9F1EC;strokeColor=#288779;fontColor=#15323B;fontSize=13;align=center;verticalAlign=middle;spacing=8;fontStyle=0;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="345" y="675" width="365" height="155" as="geometry" />
        </mxCell>
        <mxCell id="so15" value="local features" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#52747C;strokeWidth=2;dashed=0;startArrow=none;startFill=1;endArrow=block;endFill=1;fontColor=#526B73;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="so10" target="so14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
