        <mxCell id="ov13" value="构图" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C88729;strokeWidth=2;dashed=1;startArrow=none;startFill=1;endArrow=block;endFill=1;fontColor=#526B73;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ov7" target="ov8">
